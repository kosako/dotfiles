{{- template "require-profile" . -}}
{{- $prof := index .profiles .profile -}}
{{- $caps := index $prof "capabilities" -}}
{{- $profileModules := index $prof "modules" -}}
{{/* Allowlist (#207): ignore every target, then un-ignore ("!") exactly the
     paths declared by modules that are active for this profile — a module
     is active when the profile lists it and every capability in its
     requires: matches. chezmoi gives "!" patterns precedence regardless of
     line order, and a directory that stays ignored takes its whole subtree
     with it, so every ancestor of a declared path is un-ignored as well.
     An ancestor line is pass-through plumbing only: it admits the directory
     entry itself, never its other children (a sibling needs its own
     declaration). Everything else — repo-management files (README, docs,
     scripts, ...), user-local files next to managed ones
     (.claude/settings.local.json), and any undeclared source entry, tracked
     or not — stays under "**" and is never applied to any profile. */}}
**
{{- range $name, $module := .modules }}
{{- if hasKey $module "paths" }}
{{- $enabled := has $name $profileModules }}
{{- if hasKey $module "requires" }}
{{- range $capability, $want := $module.requires }}
{{- if ne (index $caps $capability) $want }}
{{- $enabled = false }}
{{- end }}
{{- end }}
{{- end }}
{{- if $enabled }}
{{- range $module.paths }}
{{- $parts := splitList "/" . }}
{{- range $i, $_ := $parts }}
!{{ slice $parts 0 (add1 $i) | join "/" }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
