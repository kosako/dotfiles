{{- /* Shared "hooks" object for the two AI homes — the Claude (#137 / #199 /
       #225) and Codex (#181 / #199 / #225) registrations rendered from ONE
       place so the two cannot drift apart (fixing one side and forgetting the
       other was the standing hazard). dict args: caps (the profile's
       capabilities map), homeDir (.chezmoi.homeDir), agentDir (".claude" or
       ".codex"), optional timeout (number; applied to the safe-gh hook only —
       Codex passes 10).

       Four capabilities contribute events, each self-gated here (the fourth,
       enableToolCallRecordHook, is Claude-only; see the note at the body):
       - enableGitHubIsolatedReader: PreToolUse / matcher Bash ->
         personal-safe-gh-hook (GitHub read steering, #137 / #181).
       - enableQualityLoopHooks: PostToolUse / matcher Edit|Write ->
         personal-fast-edit-check (steering, never blocks) and Stop ->
         personal-changed-scope-qa (best-effort gate) — the quality loop of
         agent-tools#203, wired by #199. Stop takes no matcher in either
         harness (Claude Code: unsupported; Codex: ignored), so none is
         emitted. No timeout is set on these two: both harnesses default to
         600s and the declared checks' runtime is owned by the user's
         checks.local.json (edit checks ~100s of ms, QA checks ~seconds per
         the agent-tools contract), so no value is invented here.
       - enableHerdrIntegration: SessionStart -> herdr's own
         herdr-agent-state.sh (#225, agent-tools#252 hand-off): reports the
         agent session id to the herdr server from inside a herdr pane
         (native session restore); exits 0 elsewhere. Body = herdr, not
         agent-tools: `herdr integration install <agent>` writes and versions
         it, at herdr's per-agent location (<home>/.claude/hooks/ for Claude,
         <home>/.codex/ flat for Codex — herdr v0.9.0 `integration status`).
         The entry is rendered in EXACTLY the shape that installer emits —
         command `bash '<path>' session`, timeout 10, matcher
         "^(startup|resume|clear|compact|fork)$" on Claude (herdr 0.9.3,
         integration v10; #274) and none on Codex. On Claude herdr compares
         the WHOLE entry with its canonical one (src/integration/
         claude_settings.rs) and replaces a legacy "*" entry, so the matcher
         must follow herdr's; on Codex it matches by type=command + the
         command string (src/integration/config_edit.rs ensure_command_hook)
         — so the installer recognizes the managed registration and adds no
         duplicate (measured: settings.json stays
         byte-identical; Codex re-serializes hooks.json with the same
         content, which the next apply restores).
       - enableToolCallRecordHook (#353, agent-tools#454): SessionStart (no
         matcher) and PreToolUse / PostToolUse / PostToolUseFailure /
         PermissionDenied (matcher "*") -> personal-tool-call-record-hook,
         "async": true, timeout 10 (record / fail-open: one JSON line per
         event, argument keys only, never blocks; an async hook cannot
         block, Claude Code 2.1.295 hooks docs, 2026-10-09). CLAUDE ONLY —
         the Codex side is out of scope in agent-tools#454, so on
         agentDir ".codex" it contributes nothing and the Codex render is
         unchanged. Where an event already has an entry it is appended as
         the SECOND element and the first stays byte-identical (herdr's
         whole-entry match is unaffected by a sibling element).
       The home path reaches each command string through the shell-word
       template (quoted only when it holds a character a shell would act
       on; the herdr path is always single-quoted, as herdr writes it, with
       each `'` as '\''), and every string is JSON-encoded with toJson, so
       a home with a space or a quote neither breaks the JSON nor splits
       the command; a normal home renders unchanged (#329).
       Every agent-tools body is deployed at the stable path
       <home>/<agentDir>/agent-tools/scripts/<name> (agent-tools#146);
       dotfiles references it by absolute path and distributes no script.
       All hooks are fail-open at runtime when the body is missing (exit 127
       is a non-blocking hook error in both harnesses), so rendering before
       agent-tools has synced or herdr has installed is a safe no-op.

       Callers include this only when at least one of the four capabilities
       is on (an empty "hooks": {} is never rendered; the Codex caller keeps
       gating on the three it renders). Renders at two-space
       indent with NO trailing comma and NO trailing newline — the caller
       owns both (Claude appends ",", Codex a bare newline). */ -}}
{{- $scripts := printf "%s/%s/agent-tools/scripts" .homeDir .agentDir -}}
{{- $herdrClaude := eq .agentDir ".claude" -}}
{{- $herdrHook := printf "%s/%s/herdr-agent-state.sh" .homeDir .agentDir -}}
{{- if $herdrClaude -}}{{- $herdrHook = printf "%s/%s/hooks/herdr-agent-state.sh" .homeDir .agentDir -}}{{- end -}}
{{- $reader := index .caps "enableGitHubIsolatedReader" -}}
{{- $quality := index .caps "enableQualityLoopHooks" -}}
{{- $herdr := index .caps "enableHerdrIntegration" -}}
{{- /* enableToolCallRecordHook (#353) is Claude-only: the Codex registration is
       out of scope there (agent-tools#454), so the Codex render must not change.
       The events are built event by event below so that a record entry can be
       appended AFTER an existing entry of the same event (PreToolUse: safe-gh,
       PostToolUse: fast-edit-check, SessionStart: herdr) without touching it,
       and so that an event only the recorder uses (PostToolUseFailure,
       PermissionDenied) is emitted only when the recorder is on. With the
       recorder off the output is byte-identical to the previous per-capability
       rendering (pinned by test-claude-settings.sh). */ -}}
{{- $record := and (index .caps "enableToolCallRecordHook") $herdrClaude -}}
{{- $recordCmd := includeTemplate "shell-word" (printf "%s/personal-tool-call-record-hook" $scripts) | toJson -}}
{{- /* The record entry itself lives in agent-hooks-record-entry (a define
       inside this file is not visible to chezmoi's template action). */ -}}
{{- $sep := "" -}}
{{ "" }}  "hooks": {
{{- if or $reader $record }}
    "PreToolUse": [
{{- if $reader }}
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": {{ includeTemplate "shell-word" (printf "%s/personal-safe-gh-hook" $scripts) | toJson }}
{{- if hasKey . "timeout" }},
            "timeout": {{ .timeout }}
{{- end }}
          }
        ]
      }
{{- end }}
{{- if and $reader $record }},{{ end }}
{{- if $record }}
{{ includeTemplate "agent-hooks-record-entry" (dict "cmd" $recordCmd "matcher" "*") }}
{{- end }}
    ]
{{- $sep = "," -}}
{{- end }}
{{- if or $quality $record }}{{ $sep }}
    "PostToolUse": [
{{- if $quality }}
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": {{ includeTemplate "shell-word" (printf "%s/personal-fast-edit-check" $scripts) | toJson }}
          }
        ]
      }
{{- end }}
{{- if and $quality $record }},{{ end }}
{{- if $record }}
{{ includeTemplate "agent-hooks-record-entry" (dict "cmd" $recordCmd "matcher" "*") }}
{{- end }}
    ]
{{- $sep = "," -}}
{{- end }}
{{- if $quality }}{{ $sep }}
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ includeTemplate "shell-word" (printf "%s/personal-changed-scope-qa" $scripts) | toJson }}
          }
        ]
      }
    ]
{{- $sep = "," -}}
{{- end }}
{{- if or $herdr $record }}{{ $sep }}
    "SessionStart": [
{{- if $herdr }}
      {
{{- if $herdrClaude }}
        "matcher": "^(startup|resume|clear|compact|fork)$",
{{- end }}
        "hooks": [
          {
            "type": "command",
            "command": {{ printf "bash '%s' session" (replace "'" "'\\''" $herdrHook) | toJson }},
            "timeout": 10
          }
        ]
      }
{{- end }}
{{- if and $herdr $record }},{{ end }}
{{- if $record }}
{{ includeTemplate "agent-hooks-record-entry" (dict "cmd" $recordCmd) }}
{{- end }}
    ]
{{- $sep = "," -}}
{{- end }}
{{- if $record }}{{ $sep }}
    "PostToolUseFailure": [
{{ includeTemplate "agent-hooks-record-entry" (dict "cmd" $recordCmd "matcher" "*") }}
    ],
    "PermissionDenied": [
{{ includeTemplate "agent-hooks-record-entry" (dict "cmd" $recordCmd "matcher" "*") }}
    ]
{{- end }}
  }
{{- /* no trailing newline: see the header comment */ -}}
