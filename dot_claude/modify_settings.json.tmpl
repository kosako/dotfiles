#!/bin/sh
# ~/.claude/settings.json: a chezmoi modify script (dotfiles #360). chezmoi
# runs it with the live file on stdin (empty when there is none) and writes
# what it prints back. Without a live file it prints the managed JSON below
# unchanged. With one, it keeps the live file and changes only what the
# template manages:
#   - every top-level key of the managed JSON is set to the template's value
#     where it differs (jq's == ignores object key order, so an equal value
#     keeps its live bytes), except "model": Claude Code writes the /model
#     choice there, so the template's value is only the default for a file
#     that has none;
#   - "sandbox" and "hooks", which the template emits only while their
#     capabilities are on, are removed while it does not emit them;
#   - every other key (modelSettings, autoMode, keys Claude Code adds later)
#     stays as it is, in place.
# When that leaves the live file the same JSON, the live bytes come back
# as they were (so the one-line arrays of a first apply, or any other
# formatting, never show as a diff); otherwise jq prints the result with
# two-space indentation, which is also how Claude Code writes the file.
# A live file that is not exactly one JSON object (whitespace only, several
# values, an array, broken JSON, a NUL byte) stops the apply instead of
# being replaced; only an empty one (0 bytes, also what chezmoi passes when
# there is none) gets the managed JSON.
set -eu
managed=$(cat <<'CLAUDE_SETTINGS_JSON'
{
{{- if index $caps "enforceAiSandbox" }}
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": []
    }
  },
{{- end }}
  "permissions": {
{{- if $deny }}
    "deny": {{ $deny | toJson }},
{{- end }}
{{- if $ask }}
    "ask": {{ $ask | toJson }},
{{- end }}
    "allow": [
      "mcp__pencil"
    ]
  },
{{- if or (index $caps "enableGitHubIsolatedReader") (index $caps "enableQualityLoopHooks") (index $caps "enableHerdrIntegration") (index $caps "enableToolCallRecordHook") }}
{{ template "agent-hooks-json" (dict "caps" $caps "homeDir" .chezmoi.homeDir "agentDir" ".claude") }},
{{- end }}
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": {{ printf "%s statusline" (includeTemplate "shell-word" (printf "%s/go/bin/tacho" .chezmoi.homeDir)) | toJson }},
    "padding": 0
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "codex@openai-codex": true,
    "notion@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc",
        "ref": "v1.0.4"
      },
      "autoUpdate": false
    }
  },
  "effortLevel": "xhigh",
  "agentPushNotifEnabled": true,
  "remoteControlAtStartup": true,
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "tui": "fullscreen"
}
CLAUDE_SETTINGS_JSON
)
# The live file stays in this variable (#446). No temp file: one would stop
# the script where TMPDIR cannot be written and outlive a killed script as a
# copy of the file (chezmoi itself still writes this script, which holds no
# live content, to its scriptTempDir, TMPDIR by default, before running it;
# the temp file bash as /bin/sh makes for the heredoc above holds only the
# public managed JSON, and bash falls back to a system temp dir for it). jq
# reads it on stdin, never from its arguments, which ps shows to other
# users (autoMode is not public); printf is a shell builtin, so its
# arguments never reach a process list. The x keeps the trailing newlines a
# command substitution would drop, so the bytes come back exactly. A shell
# variable cannot hold NUL, which JSON never has: tr turns it into SOH, a
# raw control byte jq rejects anywhere, so a file with NUL stops the apply
# instead of losing those bytes, a NUL at the very end too (jq reading the
# file itself lets that one pass). LC_ALL=C keeps tr to bytes: in a UTF-8
# locale BSD tr stops on a byte that is not UTF-8, which jq reads in a
# string.
live=$(LC_ALL=C tr '\000' '\001' && printf x)
live=${live%x}
if [ -z "$live" ]; then
  printf '%s\n' "$managed"
  exit 0
fi
if ! command -v jq >/dev/null 2>&1; then
  echo "dotfiles: jq is required to update the existing ~/.claude/settings.json (it keeps the keys the template does not manage)" >&2
  exit 1
fi
# One jq run checks, merges and compares: it prints the merged JSON, or
# nothing when that is the live file's JSON again. The managed JSON is the
# template's (public), so it may stay an argument.
merged=$(printf '%s' "$live" | jq -s --argjson managed "$managed" '
  if length != 1 or (.[0] | type) != "object"
  then error("~/.claude/settings.json is not exactly one JSON object") else .[0] end
  | . as $live
  | reduce ($managed | keys_unsorted[]) as $key (.;
      if ($key == "model" and has("model")) or .[$key] == $managed[$key] then .
      else .[$key] = $managed[$key] end)
  | reduce ("sandbox", "hooks") as $key (.;
      if $managed | has($key) then . else del(.[$key]) end)
  | if . == $live then empty else . end')
if [ -z "$merged" ]; then
  printf '%s' "$live"
else
  printf '%s\n' "$merged"
fi
