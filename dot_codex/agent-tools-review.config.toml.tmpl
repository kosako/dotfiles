{{- template "require-profile" . -}}
{{- $caps := index .profiles .profile "capabilities" -}}
{{- /* Codex profile file for agent-tools' personal-codex-review (#264,
       agent-tools#339 hand-off). The file name is agent-tools' public
       contract. The review is NOT started with -p (agent-tools#358): it runs
       with --ignore-user-config, reads only the top-level `model` /
       `model_reasoning_effort` of this file (over the same keys in
       config.toml) and re-passes them with -c, so no other key — a service
       tier included — ever reaches the review (#299). It parses with the
       worker preflight's reader (no TOML parser): only the lines before the
       first table header count, each must be blank, a comment or
       `bare_key = <one-line scalar or flat array>`, and `model` /
       `model_reasoning_effort` must each appear once as a one-line basic
       string with a value in [A-Za-z0-9._-]+; anything else fails closed
       (the review stops as BLOCKED). Keep this file to comments and the
       single `model_reasoning_effort = "<value>"` line.
       Content = dotfiles (per-profile value), reader = agent-tools, and
       Codex never rewrites it — unlike the codex-owned config.toml, which
       dotfiles does not manage.

       Only the reasoning effort is set (the value is the codexReviewEffort
       enum, validated by validate-policy and the require-profile guard): the
       model comes from config.toml.

       Gating (template self-gate, NOT a module `requires` — #184 lesson):
       codexReviewEffort=off renders EMPTY and chezmoi removes the managed
       target, so review falls back to the config.toml top-level values.
       Active for profiles that list the codex-settings module (personal).
       The managed-by header lets doctor's managed-path orphans flag a copy
       left behind by a profile switch (#201). */ -}}
{{- $effort := index $caps "codexReviewEffort" -}}
{{- if ne $effort "off" -}}
# Managed by chezmoi from kosako/dotfiles (codex-settings, #264).
# Profile for agent-tools' personal-codex-review: it reads only the top-level
# model / model_reasoning_effort here. Effort only; the model comes from
# ~/.codex/config.toml.
model_reasoning_effort = "{{ $effort }}"
{{ end -}}
