{{- template "require-profile" . -}}
{{- $caps := index .profiles .profile "capabilities" -}}
{{- /* Codex approval-rules baseline (#139). The canonical, vetted allowlist for
       Codex's command-approval rules: READ-ONLY subcommands and local-only git
       operations. Nothing here may auto-allow an outward action (push, PR/issue
       create, comment, release, external send) or an escalation (sudo, auth
       login) — those must go through Codex's per-invocation approval
       (docs/ai-policy.md). A context-gated write hook is not built (#131
       closed without it; no tracking issue).
       `git clone` is deliberately NOT allowed (Codex review #187): a clone
       fetches from an arbitrary remote (network egress; the URL itself is a
       covert channel under the injection threat model), so it stays behind
       per-invocation approval.
       `gh auth status` is not allowed: prefix matching cannot exclude flags
       that display tokens, so even the bare command stays behind approval.

       Why this file is chezmoi-managed (#139 decision): Codex approval grants
       accumulate ("don't ask again" piles up in local state) and the permission
       gate erodes silently — the 2026-07-02 audit found outward allows (git
       push, blanket gh pr/issue) that nobody decided deliberately. Managing the
       baseline turns that erosion into visible drift: accumulated grants show up
       in `chezmoi status` / doctor's drift report, and `chezmoi apply` resets
       the file to this vetted baseline (the reset half of 棚卸し, mechanized;
       apply itself stays a manual step).
       NOTE: [projects] trust in ~/.codex/config.toml is the OTHER accumulation
       channel and cannot be managed (codex-owned live file, #181) — doctor
       watches it report-only instead.

       Destructive git and hook skips (#304, after agent-tools#204 left
       them to the hosts' permissions; the Claude and OpenCode floors carry
       the same set): work-discarding git is "prompt" and a hook skip is
       "forbidden". Codex rules match a PREFIX of the argv only, and the
       strictest matching rule wins (measured with `codex execpolicy check`
       on 0.159.3), so a forbidden / prompt rule outranks the `git commit`
       / `git checkout` allows above, but only the forms that put the option
       right after the subcommand are caught: `git commit -m x --no-verify`,
       `git reset HEAD --hard`, `git checkout HEAD -- a`, `git -C dir ...`
       and a +refspec push are not (the user kept the allows rather than
       prompting every commit / checkout). The hook skips are forbidden in
       that one position, like the Claude / OpenCode deny; their other
       placements cannot be expressed here. Codex rules see commands only,
       so the reference-note write deny of the other floors has no
       counterpart. Steering, not a boundary.

       Gating (template self-gate, NOT a module `requires` — #184 lesson):
       enableAiPolicy=false renders EMPTY and chezmoi removes the managed target
       (a `requires:` gate would leave an already-applied file lingering).
       Active for profiles that list the codex-settings module (personal). */ -}}
{{- if index $caps "enableAiPolicy" -}}
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "checkout"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "list"], decision="allow")
prefix_rule(pattern=["gh", "pr", "diff"], decision="allow")
prefix_rule(pattern=["gh", "pr", "checks"], decision="allow")
prefix_rule(pattern=["gh", "issue", "view"], decision="allow")
prefix_rule(pattern=["gh", "issue", "list"], decision="allow")
prefix_rule(pattern=["git", "reset", "--hard"], decision="prompt")
prefix_rule(pattern=["git", "clean"], decision="prompt")
prefix_rule(pattern=["git", "checkout", ["--", ".", "-f", "--force", "-qf", "-fq"]], decision="prompt")
prefix_rule(pattern=["git", "switch", ["-f", "--force", "--discard-changes", "-qf", "-fq"]], decision="prompt")
prefix_rule(pattern=["git", "restore"], decision="prompt")
prefix_rule(pattern=["git", "push", ["--force", "-f", "-uf", "-fu"]], decision="prompt")
prefix_rule(pattern=["git", "branch", ["-D", "--force", "-f", "-df", "-fd"]], decision="prompt")
prefix_rule(pattern=["git", "commit", ["-nm", "-an", "-anm"]], decision="prompt")
prefix_rule(pattern=["git", "commit", ["--no-verify", "-n"]], decision="forbidden")
prefix_rule(pattern=["git", "push", "--no-verify"], decision="forbidden")
{{ end -}}
