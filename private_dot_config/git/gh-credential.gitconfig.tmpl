{{- template "require-profile" . -}}
{{- $caps := index .profiles .profile "capabilities" -}}
{{- $gh := lookPath "gh" -}}
{{- /* GitHub's HTTPS credential helper set to gh (#492). Pulled into
       ~/.gitconfig via an UNCONDITIONAL [include] there: Git silently
       ignores a missing include path, so the include is a no-op until this
       file renders (the signing.gitconfig pattern). `gh auth setup-git`
       writes the same lines into ~/.gitconfig, where the next chezmoi apply
       drops them, so they live here instead.

       Two-key gate: enableGhCredentialHelper (intent) AND, at apply time, a
       gh on PATH at an absolute path that needs no quoting (readiness). Git
       runs the helper line through the shell and gh writes it unquoted, so
       a path with a space or a quote is not ready. Either key missing
       renders EMPTY and chezmoi prunes the target (a template self-gate, not
       a module `requires`, as for the git hook gates: with `requires`, a
       file left from before the capability was turned off would stay, and
       the unconditional include would keep using it). Git then goes back
       to the system helper, and doctor reports why.

       Each URL first resets its helper list (`helper =`), so the system
       helper (osxkeychain) is not asked for these hosts; other hosts keep
       it. The token stays in gh, never here. */ -}}
{{- if and (index $caps "enableGhCredentialHelper") (regexMatch "^/[A-Za-z0-9_@%+=:,./-]+$" $gh) -}}
# Managed by chezmoi from kosako/dotfiles (gh-credential-helper, #492).
# Read via the unconditional [include] in ~/.gitconfig. GitHub's HTTPS
# credentials come from gh (the token gh holds); other hosts keep the
# system helper. The gh path is the one found on PATH at apply time.
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
{{ end -}}
