{{- template "require-profile" . -}}
{{- /* OpenCode harness floor (#234). Managed for profiles that list the
       opencode-settings module (personal). OpenCode merges its config sources
       (global -> OPENCODE_CONFIG -> project opencode.json -> ...), later ones
       overriding earlier, so this global file is a FLOOR that a project or a
       local OPENCODE_CONFIG file can raise or (deliberately) lower — the same
       standing as the managed ~/.claude/settings.json: a public-safe default,
       not an enforcement boundary (docs/opencode-settings.md).

       What is here and why:
       - permission: OpenCode defaults to allow-all. The read deny mirrors the
         Claude secret floor (SSH keys, credential stores incl. the Codex and
         OpenCode auth.json) and also denies .env, which on the Claude side is
         the enforceAiSandbox human-legit gate (off on personal), not the
         floor — so this floor is stricter there. bash, per docs/ai-policy.md
         (read-only local work needs no approval; leaving the machine or
         escalating does): `git push` / `git clone`, sudo, curl, wget are
         ask, and the GitHub CLI is ask BY DEFAULT (`gh *`) with only the
         read-only subcommands allowed back (view / list / diff / checks /
         status, auth status, search, help) — enumerating mutations was the
         #240 gap (`gh issue edit`, `gh pr close`, `gh api -XPOST`, ... fell
         to allow-all), and `gh api` stays ask whatever the method because
         short-flag forms (`-XPOST`, `-ftitle=x`) defeat flag matching and
         GraphQL reads POST anyway. `gh auth status` is allowed only in its
         bare form: `--show-token` / `-t` print the token, and `gh auth
         token` exists for that alone, so those are deny (Codex review, PR
         #249). Rules are last-match-wins, so the deny rules (env dump, gh
         secret / secrets API, token display, ssh keys) come LAST: an
         earlier deny would be overridden by a later, broader ask. The ask
         patterns end in a bare `*` with no space before it on purpose: `*`
         matches zero or more characters, so `git push*` covers both the
         argument-less `git push` (upstream set) and `git push origin main`,
         whereas `git push *` would miss the bare form and fall through to
         the allow-all base (Codex review, PR #235). That spelling is only
         safe for ask / deny (over-matching asks more); each read ALLOW is
         instead a pair — the exact bare form and `... *` with a space — so
         the command name is delimited and an alias such as `gh status-token`
         (→ `auth token`) does not ride an allow for `gh status` (Codex
         review, PR #249). Exceptions: `gh search *` has no bare form, so a
         bare `gh search` stays ask; `gh auth status` (see above),
         `gh --version` and `gh version` are bare-only. `gh *` keeps the
         space so `ghq` and friends are not caught; the bare `gh` prints help.
         scripts/test-opencode-settings.sh pins this map exactly AND
         evaluates it against a fixed command set (doctor's Codex outward
         probes plus short-flag / alias / read forms).
         #304 adds the Claude floor's git rules (dot_claude/settings.json.tmpl
         explains them): work-discarding git and hook skips in any placement
         ask — each option a word of its own after its subcommand, generated
         from the (subcommand, option) pairs below — and the hook skips right
         after `git commit` / `git push` deny, at the end with the other
         denies. OpenCode has no rule that makes a trailing " *" match the
         bare command, so those denies list the bare form too.
       - edit (#304): allow-all, but the user-owned reference note
         .agent-context.local.md is deny (agents read it, never write it):
         the bare name for a path relative to the start directory, and the
         same name behind a leading star and a slash — the star matches any
         character, `/` included (the pattern is not spelled out here: its
         star-slash would end this template comment) — for one in a sub
         directory or an absolute path, while a
         look-alike such as example.agent-context.local.md stays allowed
         (Codex review R1, PR #327). Which path form OpenCode passes to the
         edit rules is not stated in its docs and not verified against a
         running OpenCode; the two patterns cover both forms under the
         documented glob. Writes from bash are not covered.
       - autoupdate off: update-policy (no self-updating tools; updates are
         deliberate, via the catalog source).
       - share disabled: no session upload surface (public safety).
       - instructions: agent-tools' operating rules. OpenCode reads
         ~/.claude/CLAUDE.md for Claude Code compatibility but does not follow
         its `@` import, so the imported file is named explicitly.
       NOT here (local, unmanaged): provider / model (personal choice, like
       #93 for Claude), auth (~/.local/share/opencode/auth.json), plugins,
       mcp, agents. Put local additions in a file named by OPENCODE_CONFIG
       (merged after this one); TUI settings go in the separate, also local
       tui.json (path overridable by OPENCODE_TUI_CONFIG). */ -}}
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "instructions": [
    "{{ .chezmoi.homeDir }}/.claude/agent-tools/CLAUDE.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.netrc": "deny",
      "~/.codex/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      ".agent-context.local.md": "deny",
      "*/.agent-context.local.md": "deny"
    },
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git clone*": "ask",
      "gh *": "ask",
      "gh pr view": "allow",
      "gh pr view *": "allow",
      "gh pr list": "allow",
      "gh pr list *": "allow",
      "gh pr diff": "allow",
      "gh pr diff *": "allow",
      "gh pr checks": "allow",
      "gh pr checks *": "allow",
      "gh pr status": "allow",
      "gh pr status *": "allow",
      "gh issue view": "allow",
      "gh issue view *": "allow",
      "gh issue list": "allow",
      "gh issue list *": "allow",
      "gh issue status": "allow",
      "gh issue status *": "allow",
      "gh repo view": "allow",
      "gh repo view *": "allow",
      "gh release view": "allow",
      "gh release view *": "allow",
      "gh release list": "allow",
      "gh release list *": "allow",
      "gh run view": "allow",
      "gh run view *": "allow",
      "gh run list": "allow",
      "gh run list *": "allow",
      "gh workflow view": "allow",
      "gh workflow view *": "allow",
      "gh workflow list": "allow",
      "gh workflow list *": "allow",
      "gh label list": "allow",
      "gh label list *": "allow",
      "gh gist view": "allow",
      "gh gist view *": "allow",
      "gh gist list": "allow",
      "gh gist list *": "allow",
      "gh search *": "allow",
      "gh status": "allow",
      "gh status *": "allow",
      "gh auth status": "allow",
      "gh --version": "allow",
      "gh version": "allow",
      "gh help": "allow",
      "gh help *": "allow",
      "sudo*": "ask",
      "curl*": "ask",
      "wget*": "ask",
      "op *": "ask",
{{- range list "git clean *" "git * clean *" "git restore *" "git * restore *" "git *checkout* -- *" "git *checkout* ." "git *push* +*" }}
      {{ . | toJson }}: "ask",
{{- end }}
{{- range list (list "reset" "--hard") (list "checkout" "--force") (list "checkout" "-f") (list "checkout" "-qf") (list "checkout" "-fq") (list "switch" "--force") (list "switch" "--discard-changes") (list "switch" "-f") (list "switch" "-qf") (list "switch" "-fq") (list "push" "--force") (list "push" "-f") (list "push" "-uf") (list "push" "-fu") (list "branch" "-D") (list "branch" "--force") (list "branch" "-f") (list "branch" "-df") (list "branch" "-fd") (list "commit" "-n") (list "commit" "-nm") (list "commit" "-an") (list "commit" "-anm") }}
      {{ printf "git *%s* %s" (index . 0) (index . 1) | toJson }}: "ask",
      {{ printf "git *%s* %s *" (index . 0) (index . 1) | toJson }}: "ask",
{{- end }}
      "git *--no-verify*": "ask",
      "cat ~/.ssh/*": "deny",
      "gh secret *": "deny",
      "gh api *secrets*": "deny",
      "gh auth token*": "deny",
      "gh auth status*--show-token*": "deny",
      "gh auth status* -t*": "deny",
      "gh auth status* -at*": "deny",
      "gh -* auth *": "deny",
      "gh auth -*": "deny",
      "env": "deny",
      "env *": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "security find-generic-password*": "deny",
      "security * find-generic-password*": "deny",
      "security find-internet-password*": "deny",
      "security * find-internet-password*": "deny",
      "security dump-keychain*": "deny",
      "security * dump-keychain*": "deny",
      "security export*": "deny",
      "security * export*": "deny",
      "git commit --no-verify": "deny",
      "git commit --no-verify *": "deny",
      "git push --no-verify": "deny",
      "git push --no-verify *": "deny",
      "git commit -n": "deny",
      "git commit -n *": "deny"
    }
  }
}
