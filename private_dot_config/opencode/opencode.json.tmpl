{{- template "require-profile" . -}}
{{- /* OpenCode harness floor (#234). Managed for profiles that list the
       opencode-settings module (personal). OpenCode merges its config sources
       (global -> OPENCODE_CONFIG -> project opencode.json -> ...), later ones
       overriding earlier, so this global file is a FLOOR that a project or a
       local OPENCODE_CONFIG file can raise or (deliberately) lower — the same
       standing as the managed ~/.claude/settings.json: a public-safe default,
       not an enforcement boundary (docs/opencode-settings.md).

       What is here and why:
       - permission: OpenCode defaults to allow-all. The read deny mirrors the
         Claude secret floor (SSH keys, credential stores incl. the Codex and
         OpenCode auth.json, .env). bash, per docs/ai-policy.md (read-only
         local work needs no approval; leaving the machine or escalating
         does): `git push` / `git clone`, sudo, curl, wget are ask, and the
         GitHub CLI is ask BY DEFAULT (`gh *`) with only the read-only
         subcommands allowed back (view / list / diff / checks / status,
         auth status, search, help) — enumerating mutations was the #240
         gap (`gh issue edit`, `gh pr close`, `gh api -XPOST`, ... fell to
         allow-all), and `gh api` stays ask whatever the method because
         short-flag forms (`-XPOST`, `-ftitle=x`) defeat flag matching and
         GraphQL reads POST anyway. `gh auth status` is allowed only in its
         bare form: `--show-token` / `-t` print the token, and `gh auth
         token` exists for that alone, so those are deny (Codex review, PR
         #249). Rules are last-match-wins, so the deny rules (env dump, gh
         secret / secrets API, token display, ssh keys) come LAST: an
         earlier deny would be overridden by a later, broader ask. The ask
         patterns end in a bare `*` with no space before it on purpose: `*`
         matches zero or more characters, so `git push*` covers both the
         argument-less `git push` (upstream set) and `git push origin main`,
         whereas `git push *` would miss the bare form and fall through to
         the allow-all base (Codex review, PR #235). `gh *` keeps the space
         so `ghq` and friends are not caught; the bare `gh` prints help.
         scripts/test-opencode-settings.sh pins this map exactly AND
         evaluates it against a fixed command set (doctor's Codex outward
         probes plus short-flag / alias / read forms).
       - autoupdate off: update-policy (no self-updating tools; updates are
         deliberate, via the catalog source).
       - share disabled: no session upload surface (public safety).
       - instructions: agent-tools' operating rules. OpenCode reads
         ~/.claude/CLAUDE.md for Claude Code compatibility but does not follow
         its `@` import, so the imported file is named explicitly.
       NOT here (local, unmanaged): provider / model (personal choice, like
       #93 for Claude), auth (~/.local/share/opencode/auth.json), plugins,
       mcp, agents, tui. Put local additions in a file named by OPENCODE_CONFIG
       (merged after this one). */ -}}
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "instructions": [
    "{{ .chezmoi.homeDir }}/.claude/agent-tools/CLAUDE.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.netrc": "deny",
      "~/.codex/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git clone*": "ask",
      "gh *": "ask",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh pr status*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh issue status*": "allow",
      "gh repo view*": "allow",
      "gh release view*": "allow",
      "gh release list*": "allow",
      "gh run view*": "allow",
      "gh run list*": "allow",
      "gh workflow view*": "allow",
      "gh workflow list*": "allow",
      "gh label list*": "allow",
      "gh gist view*": "allow",
      "gh gist list*": "allow",
      "gh search *": "allow",
      "gh status*": "allow",
      "gh auth status": "allow",
      "gh --version": "allow",
      "gh version": "allow",
      "gh help*": "allow",
      "sudo*": "ask",
      "curl*": "ask",
      "wget*": "ask",
      "cat ~/.ssh/*": "deny",
      "gh secret *": "deny",
      "gh api *secrets*": "deny",
      "gh auth token*": "deny",
      "gh auth status*--show-token*": "deny",
      "gh auth status* -t*": "deny",
      "env": "deny",
      "env *": "deny",
      "printenv": "deny",
      "printenv *": "deny"
    }
  }
}
