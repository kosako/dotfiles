{
  "uid": "ai-agents-codex",
  "title": "AI agents (Codex)",
  "description": "Managed by chezmoi from kosako/dotfiles (otel-backend module, #517). The telemetry of Codex (logs in Loki, metrics in Prometheus, traces in Tempo) received by the local otel-lgtm. Edit the JSON in dotfiles, not in the UI.",
  "tags": [
    "ai-agents",
    "codex"
  ],
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service_name",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "",
          "type": 1
        },
        "definition": "label_values(service_name)",
        "regex": "/^codex.*/",
        "includeAll": true,
        "multi": true,
        "allValue": "codex.*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "概要 (表示している期間の合計)",
