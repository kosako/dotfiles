            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"$service\"} | event_name=\"codex.conversation_starts\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
