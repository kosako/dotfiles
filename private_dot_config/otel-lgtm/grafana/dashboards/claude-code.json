          "label": "service_name",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "",
          "type": 1
        },
        "definition": "label_values(service_name)",
        "regex": "/^claude-code.*/",
        "includeAll": true,
        "multi": true,
        "allValue": "claude-code.*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
