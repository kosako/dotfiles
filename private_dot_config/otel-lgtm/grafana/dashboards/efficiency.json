    "ai-agents",
    "efficiency"
  ],
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-29d/d",
    "to": "now/d"
  },
  "refresh": "5m",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "Asia/Tokyo",
  "links": [
    {
      "title": "AI agents",
      "type": "dashboards",
      "tags": [
        "ai-agents"
      ],
      "asDropdown": true,
      "includeVars": false,
