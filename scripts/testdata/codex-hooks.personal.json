{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/dotfiles-render-test-home/.codex/agent-tools/scripts/personal-safe-gh-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/dotfiles-render-test-home/.codex/agent-tools/scripts/personal-fast-edit-check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/dotfiles-render-test-home/.codex/agent-tools/scripts/personal-changed-scope-qa"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/dotfiles-render-test-home/.codex/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
